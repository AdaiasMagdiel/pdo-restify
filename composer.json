{
    "name": "adaiasmagdiel/pdo-restify",
    "description": "A framework-agnostic REST API layer on top of PDO, for MySQL, MariaDB and SQLite.",
    "type": "library",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Adaias Magdiel",
            "email": "eu@adaiasmagdiel.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-pdo": "*"
    },
    "require-dev": {
        "pestphp/pest": "^2.34",
        "ext-pdo_sqlite": "*"
    },
    "suggest": {
        "adaiasmagdiel/erlenmeyer": "A minimal front controller you can use to expose pdo-restify over HTTP"
    },
    "autoload": {
        "psr-4": {
            "AdaiasMagdiel\\PdoRestify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
